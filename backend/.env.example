# =======================================================
# HostelFix Backend Environment Configuration
# =======================================================

# Port on which the Express server listens (default: 5000)
PORT=5000

# Runtime environment (development / production / test)
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas URI or local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/hostelfix

# Allowed frontend origin for CORS and cookie exchange
CLIENT_ORIGIN=http://localhost:5173

# Secret key used for signing JWT authentication tokens
JWT_SECRET=your_long_random_jwt_secret_here

# Google OAuth 2.0 Web Client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Initial Warden / Administrator credentials for seed script
ADMIN_LOGIN_ID=admin@hostelfix.edu
ADMIN_PASSWORD=Warden@Secure2026
ADMIN_NAME=Chief Warden Office

# Cloudinary image storage (optional - falls back to local disk storage if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
