{
  "name": "hostelfix-backend",
  "version": "1.0.0",
  "description": "HostelFix Backend API - Smart Hostel Complaint & Maintenance Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/testSecuritySuite.js",
    "test:security": "node scripts/testSecuritySuite.js",
    "test:staff": "node scripts/testStaffWorkflow.js",
    "test:cloudinary": "node scripts/testCloudinaryWorkflow.js",
    "test:e2e": "node scripts/testE2EPersistence.js",
    "test:persistence": "node scripts/testPersistence.js",
